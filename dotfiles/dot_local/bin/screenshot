#!/usr/bin/bash
scale=$(hyprctl monitors -j | jq '.[] | select(.focused == true) | .scale')
hyprctl eval "hl.config({ cursor = { visible = false } })"
hyprpicker -rz &
pid=$!
image="$(mktemp)"
grim "$image"
hyprctl eval "hl.config({ cursor = { visible = true } })"
region="$(slurp -b 0B0F1877 -c cdd6f4)"
if [[ "$?" != 0 ]]; then # check if slurp was cancelled
    kill -9 $pid
    rm -f $image
    exit 1
fi
coords=${region%% *}
cx=$(awk "BEGIN { printf(\"%.10f\", ${coords%%,*} * $scale) }")
cy=$(awk "BEGIN { printf(\"%.10f\", ${coords##*,} * $scale) }")
rect=${region##* }
rx=$(awk "BEGIN { printf(\"%.10f\", ${rect%%x*} * $scale) }")
ry=$(awk "BEGIN { printf(\"%.10f\", ${rect##*x} * $scale) }")

magick "$image" -crop "${rx}x${ry}+${cx}+${cy}" "$image"

size=$(cat $image | wc -c)
if [ "$size" -gt 0 ]; then
    notify-send -i "$image" "📸 Screenshot copied to clipboard"
    cat "$image" | wl-copy 
fi

rm -f $image
kill -9 $pid
