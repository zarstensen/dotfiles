#!/bin/sh
# here we create a symlink in chezmoi source tree, back to chezmoi homeDir,
# because qmlls follows the symlink when looking for .qmlls.ini
# so we create a symlink in the chezmoi source tree, which qmlls will find,
# and will resolve back to the qmlls file which quickshell has generated
set -eufo pipefail

ln -sfn "{{ .chezmoi.homeDir }}/.config/quickshell/screen-shell/.qmlls.ini" \
  "{{ .chezmoi.sourceDir }}/dot_config/quickshell/screen-shell/.qmlls.ini"

